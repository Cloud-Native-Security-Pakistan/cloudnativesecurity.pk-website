{
  "name": "cnspk-website",
  "version": "3.0.0",
  "private": true,
  "description": "Cloud Native Security Pakistan official website",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node tools/site/build.ts",
    "build:check": "node tools/site/build.ts --check",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node tools/site/validate.ts",
    "validate:links": "node tools/site/validate.ts --external",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run build:check && npm run validate && npm test",
    "dev": "npx serve .",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "lint": "eslint js/**/*.js || true"
  },
  "keywords": [
    "cloud-native",
    "security",
    "cncf",
    "pakistan"
  ],
  "author": "Cloud Native Security Pakistan",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^24.10.0",
    "eslint": "^10.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2"
  }
}
